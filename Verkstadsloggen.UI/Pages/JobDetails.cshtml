@page "{id:guid}"
@model Verkstadsloggen.UI.Pages.JobDetails

<h1>Jobbdetaljer</h1>

@if (Model.Job != null)
{
    <div>
        <h2>@Model.Job.Title</h2>

        <p>
            <strong>Beskrivning:</strong>
            @Model.Job.Description
        </p>

        <p>
            <strong>Status:</strong>
            @Model.Job.Status
        </p>

        <p>
            <strong>ID:</strong>
            @Model.Job.Id
        </p>
        <hr />

        <h3>Kommentarer</h3>

        @if (Model.Job.Comments.Any())
        {
            foreach (var comment in Model.Job.Comments.OrderByDescending(c => c.CreatedAt))
            {
                <div class="border rounded p-2 mb-2">
                    <p class="mb-1">@comment.Text</p>
                    <small class="text-muted">@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                </div>
            }
        }
        else
        {
            <p>Inga kommentarer ännu.</p>
        }

        <form method="post" asp-page-handler="AddComment">
            <div class="mb-2">
                <textarea asp-for="NewComment"
                          class="form-control"
                          placeholder="Skriv en kommentar..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                Lägg till
            </button>
        </form>
    </div>
}