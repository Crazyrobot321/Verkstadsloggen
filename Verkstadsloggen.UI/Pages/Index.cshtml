@page
@model Verkstadsloggen.UI.Pages.DashboardModel
@{
    ViewData["Title"] = "Overview";
}

<h1 class="mb-4">Overview</h1>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Total</div>
                <div class="fs-1 fw-semibold">@Model.Jobs.Count</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Not Started</div>
                <div class="fs-1 fw-semibold">@Model.NotStarted</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">In Progress</div>
                <div class="fs-1 fw-semibold">@Model.InProgress</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Completed</div>
                <div class="fs-1 fw-semibold">@Model.Completed</div>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin") && Model.Loads.Any())
{
    <h2 class="h4">Workload per Mechanic</h2>
    <div class="mb-4">
        @foreach (var l in Model.Loads)
        {
            <div class="d-flex align-items-center gap-3 mb-2">
                <div style="width:160px">@l.Name</div>
                <div class="progress flex-grow-1" style="height:14px">
                    <div class="progress-bar bg-warning" style="flex:@l.InProgress 1 0"></div>
                    <div class="progress-bar bg-secondary" style="flex:@l.NotStarted 1 0"></div>
                    <div class="progress-bar bg-success" style="flex:@l.Completed 1 0"></div>
                </div>
                <div style="width:30px" class="text-end">@l.Total</div>
            </div>
        }
        <div class="small text-muted">
            <span class="badge bg-warning text-dark">In Progress</span>
            <span class="badge bg-secondary">Not Started</span>
            <span class="badge bg-success">Completed</span>
        </div>
    </div>
}

<h2 class="h4">Latest Jobs</h2>
@if (Model.Latest.Any())
{
    <ul class="list-group">
        @foreach (var job in Model.Latest)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@job.Title</strong>
                    <div class="small text-muted">@job.LicensePlate · @job.Status</div>
                </div>
                <a asp-page="/JobDetails" asp-route-id="@job.Id" class="btn btn-sm btn-primary">View Details</a>
            </li>
        }
    </ul>
}
else
{
    <p>No jobs to display.</p>
}