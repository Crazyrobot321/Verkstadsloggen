@page
@using Verkstadsloggen.Domain.Models
@model Verkstadsloggen.UI.Pages.PeopleModel

@{
    ViewData["Title"] = "People";

    var customerCount = Model.People.OfType<Customer>().Count();
    var mechanicCount = Model.People.OfType<Mechanic>().Count();
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">People</h1>
        <p class="text-muted mb-0">Customers and mechanics in the system.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <span class="badge text-bg-secondary fs-6 fw-normal">@Model.People.Count total</span>
        <span class="badge text-bg-primary fs-6 fw-normal">@customerCount customers</span>
        <span class="badge text-bg-warning fs-6 fw-normal">@mechanicCount mechanics</span>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-body fw-semibold">Add person</div>
            <div class="card-body">
                <form method="post">
                    <div class="btn-group w-100 mb-3" role="group" aria-label="Typ av person">
                        <input type="radio" class="btn-check" asp-for="PersonType" value="Customer" id="type-customer" />
                        <label class="btn btn-outline-primary" for="type-customer">Customer</label>

                        <input type="radio" class="btn-check" asp-for="PersonType" value="Mechanic" id="type-mechanic" />
                        <label class="btn btn-outline-primary" for="type-mechanic">Mechanic</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="FirstName" class="form-control" placeholder="First Name" />
                        <label asp-for="FirstName">First Name</label>
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="LastName" class="form-control" placeholder="Last Name" />
                        <label asp-for="LastName">Last Name</label>
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Address" class="form-control" placeholder="Address" />
                        <label asp-for="Address">Address (required for customers)</label>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" type="email" class="form-control" placeholder="E-mail" />
                        <label asp-for="Email">E-mail</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="Phone Number" />
                        <label asp-for="PhoneNumber">Phone Number</label>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Add</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm">
            @if (Model.People.Count > 0)
            {
                <ul class="list-group list-group-flush">
                    @foreach (var person in Model.People)
                    {
                        var isCustomer = person is Customer;
                        <li class="list-group-item d-flex gap-3 align-items-center">

                            <div class="d-flex align-items-center justify-content-center rounded-circle fw-semibold flex-shrink-0 @(isCustomer ? "bg-primary-subtle text-primary-emphasis" : "bg-warning-subtle text-warning-emphasis")"
                                 style="width:44px;height:44px;">
                                <i class="bi bi-person-circle fs-2"></i>
                            </div>

                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <strong>@person.FirstName @person.LastName</strong>
                                    @if (isCustomer)
                                    {
                                        <span class="badge text-bg-primary">Customer</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">Mechanic</span>
                                    }
                                </div>
                                <div class="small text-muted">
                                    <a href="mailto:@person.Email" class="text-reset">@person.Email</a>
                                    · @person.PhoneNumber
                                </div>
                                @if (person is Customer customer && !string.IsNullOrWhiteSpace(customer.Address))
                                {
                                    <div class="small text-muted">@customer.Address</div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="card-body text-center text-muted py-5">No people found.</div>
            }
        </div>
    </div>
</div>