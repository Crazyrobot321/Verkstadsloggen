@page
@model Verkstadsloggen.UI.Pages.JobsModel
@{
    ViewData["Title"] = "Jobs";
}

<form method="post">
    <div class="mb-2">
        <input asp-for="Title" class="form-control" placeholder="Enter job title" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <textarea asp-for="Description" class="form-control" placeholder="Enter job description"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <select asp-for="CustomerId" class="form-select">
            <option value="">-- Ingen kund --</option>

            @foreach (var customer in Model.customers)
            {
                <option value="@customer.Id">
                    @customer.FirstName @customer.LastName
                </option>
            }
        </select>
    </div>
    <div class="mb-2">
        <select asp-for="MechanicId" class="form-select">
            <option value="">-- Ingen mekaniker --</option>
            @foreach (var m in Model.mechanics)
            {
                <option value="@m.Id">@m.FirstName @m.LastName</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>

@if (Model.jobs.Count > 0)
{
    <h2>Job List</h2>
    <ul class="list-group">
        @foreach (var job in Model.jobs)
        { 
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <h5>@job.Title</h5>

                    <div>
                        <strong>Kund:</strong>
                        @(job.Customer != null
                            ? $"{job.Customer.FirstName} {job.Customer.LastName}"
                            : "Ingen kund")
                    </div>

                    <div>
                        <strong>Mekaniker:</strong>
                        @(job.Mechanic != null
                            ? $"{job.Mechanic.FirstName} {job.Mechanic.LastName}"
                            : "Ingen mekaniker")
                    </div>
                </div>

                <a asp-page="/JobDetails" asp-route-id="@job.Id" class="btn btn-primary">
                    Visa detaljer
                </a>
            </li>
        }
    </ul>
}
else
{
    <p>No jobs available.</p>
}