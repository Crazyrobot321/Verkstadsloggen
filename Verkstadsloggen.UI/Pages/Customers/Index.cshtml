@page
@model Verkstadsloggen.UI.Pages.Customers.IndexModel

<h2>Kunder</h2>

<a asp-page="Create" class="btn btn-success mb-3">Lägg till kund</a>

<form method="get">
    <input type="text" name="regnr" placeholder="ABC123" class="form-control" />
    <button class="btn btn-primary mt-2">Sök</button>
</form>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Namn</th>
            <th>Regnr</th>
            <th>Email</th>
            <th>Telefon</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.customers)
        {
            <tr>
                <td>@($"{c.FirstName} {c.LastName}")</td>
                <td>@c.LicensePlate</td>
                <td>@c.Email</td>
                <td>@c.PhoneNumber</td>
            </tr>
        }
    </tbody>
</table>
