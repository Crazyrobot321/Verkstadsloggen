@page
@model Verkstadsloggen.UI.Pages.Customers.CreateModel

<h2>Lägg till kund</h2>

<form method="post" class="mt-3">

    <div class="mb-3">
        <label class="form-label">Förnamn</label>
        <input asp-for="Customer.FirstName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Efternamn</label>
        <input asp-for="Customer.LastName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Adress</label>
        <input asp-for="Customer.Address" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Customer.Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Telefonnummer</label>
        <input asp-for="Customer.PhoneNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Registreringsnummer</label>
        <input asp-for="Customer.LicensePlate" class="form-control" placeholder="ABC123" />
    </div>

    <button class="btn btn-primary">Lägg till kund</button>
</form>
